APP_NAME=RentalPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Waktu disimpan UTC (config/app.php). Zona ini dipakai untuk tampilan & laporan.
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database: MySQL 8 (lihat compose.yaml di root repo untuk MySQL via Docker)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentalpro
DB_USERNAME=rentalpro
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Admin Web (React) & Sanctum SPA cookie auth
# Admin Web dan API harus berada di domain induk yang sama
# (mis. admin.rentalpro.id dan api.rentalpro.id -> SESSION_DOMAIN=.rentalpro.id).
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Landing page publik (Next.js). LANDING_URL juga otomatis diizinkan oleh CORS.
LANDING_URL=http://localhost:3000
# Webhook revalidate: Laravel memanggil URL ini saat data publik berubah (kosongkan untuk menonaktifkan).
LANDING_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Harus sama dengan REVALIDATE_SECRET di landing/.env.local. Buat dengan: openssl rand -hex 32
LANDING_REVALIDATE_SECRET=

# Public API: batas request per menit per IP, anti-spam booking, dan TTL cache (detik).
PUBLIC_API_RATE_LIMIT=120
PUBLIC_BOOKING_RATE_IP=5
PUBLIC_BOOKING_RATE_PHONE=3
PUBLIC_CACHE_TTL=600

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Produksi (HTTPS): SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email
# Development: pakai "log" (email ditulis ke storage/logs/laravel.log)
# atau Mailpit dari compose.yaml (MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025).
#
# Gmail SMTP (lihat README bagian "Setup Gmail SMTP"):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp          # STARTTLS di port 587 (atau "smtps" untuk port 465)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=akunanda@gmail.com
#   MAIL_PASSWORD="abcd efgh ijkl mnop"   # App Password 16 karakter, BUKAN kata sandi Gmail
#   MAIL_FROM_ADDRESS=akunanda@gmail.com  # harus sama dengan MAIL_USERNAME (atau alias terverifikasi)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@rentalpro.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
