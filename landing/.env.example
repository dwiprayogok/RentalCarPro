# URL publik situs ini (dipakai untuk canonical, Open Graph, sitemap).
SITE_URL=http://localhost:3000

# Public API Laravel. Server (ISR) & browser (cek ketersediaan, form) memakai URL ini.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/public

# Opsional: URL API khusus server (mis. jaringan internal Docker). Default = NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# Rahasia webhook revalidate. HARUS sama dengan LANDING_REVALIDATE_SECRET di backend/.env.
# Buat dengan: openssl rand -hex 32
REVALIDATE_SECRET=

# Interval ISR (detik) sebagai cadangan bila webhook gagal.
REVALIDATE_SECONDS=600
